<mvc:View
	controllerName="genshin.app.personagem.ListaPersonagem"
	xmlns="sap.ui.table"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:u="sap.ui.unified"
	xmlns:c="sap.ui.core"
	xmlns:m="sap.m"
	height="100%">
	<m:Page
		showHeader="false"
		enableScrolling="false"
		class="sapUiContentPadding">
		<m:content>
			<Table
				rows="{Personagem>/}"
				selectionMode="MultiToggle"
				paste="onPaste"
				title="{i18n>App.Titulo}"
				id="table"
				showColumnVisibilityMenu="{ui>/showVisibilityMenuEntry}"
				enableColumnFreeze="{ui>/showFreezeMenuEntry}"
				enableCellFilter="{ui>/enableCellFilter}"
				columnSelect="onColumnSelect"
				cellContextmenu="onProductIdCellContextMenu"
				ariaLabelledBy="title">
				<extension>
					<m:OverflowToolbar style="Clear">
						<m:Title id="title" text="Personagens" />
						<m:ToolbarSpacer />
						<!-- <m:ComboBox
                    		id="comboBoxFiltroNome"
                    		selectedKey="{filtro>/nomePersonagem}"
                    		placeholder="Nome do Personagem"
                    		items="{path: 'nomePersonagem>/'}"
                    		width="22%"
                    		change=".aoSelecionarNome">
                    		<m:items>
                        	<core:ListItem key="{nomePersonagem>key}" text="{nomePersonagem>descricao}"/>
                    		</m:items>
                		</m:ComboBox> -->
                <m:DatePicker
                    id="filtroDataPicker"
                    placeholder="Data de aquisição"
                    width="16%"
                    valueFormat="yyyy-MM-dd"
                    change=".aoFiltrarPelaData"
                    value="{
                        path: 'filtro>/data'
                    }"/>
						<m:SearchField
							placeholder="Usuario Criador"
							value="{ui>/globalFilter}"
							search="filterGlobally"
							width="auto" />
						<m:Button
							icon="sap-icon://decline"
							tooltip="Clear all filters"
							press="clearAllFilters" />
						<m:ToolbarSeparator />
					</m:OverflowToolbar>
				</extension>
				<columns>
					<Column class="autoResize">
						<m:Label text="{i18n>ListaPersonagem.Coluna.Nome}" />
						<template>
							<m:Text text="{ 
										path: 'Personagem>nomePersonagem',
										formatter: '.formatter.formatarEnumNome'
									}" 
								wrapping="false" />
						</template>
					</Column>
					<Column>
						<m:Label text="{i18n>ListaPersonagem.Coluna.Elemento}" />
						<template>
							<m:Text text="{ 
										path: 'Personagem>elemento',
										formatter: '.formatter.formatarEnumElemento'
									}"  
									wrapping="false" />
						</template>
					</Column>
					<Column>
						<m:Label text="{i18n>ListaPersonagem.Coluna.Arma}" />
						<template>
							<m:Text text="{ 
										path: 'Personagem>arma',
										formatter: '.formatter.formatarEnumArma'
									}"  
									wrapping="false" />
						</template>
					</Column>
               <Column>
						<m:Label text="{i18n>ListaPersonagem.Coluna.Usuario}" />
						<template>
							<m:Text text="{Personagem>nomeUsuario}" wrapping="false" />
						</template>
					</Column>
				</columns>
			</Table>
		</m:content>
			<m:footer>
			<m:Toolbar>
				<m:ToolbarSpacer />
				<m:Button text="{i18n>Criar.Botao}" press="aoClicarEmCriar"
					type="Ghost" />
				<m:Button text="{i18n>Detalhes.Botao}" press="aoClicarEmDetalhes"
					type="Ghost" />
			</m:Toolbar>
		</m:footer>
	</m:Page>
</mvc:View>