<mvc:View
    controllerName="genshin.app.personagem.CadastroPersonagem"
	id="CadastroPersonagem"
    xmlns="sap.m"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:l="sap.ui.layout"
	xmlns:f="sap.ui.layout.form"
    xmlns:c="sap.ui.core"
	xmlns:semantic="sap.f.semantic" >
    <MessageStrip
        text="{i18n>CadastroSucesso}"
        type="Success"
        showIcon="true"
        showCloseButton="true"
        class="sapUiTinyMargin"
        id="successMessageStrip"
        visible="false" />

    <MessageStrip
        text="{i18n>CadastroErro}"
        type="Error"
        showIcon="true"
        showCloseButton="true"
        class="sapUiTinyMargin"
        id="errorMessageStrip"
        visible="false" />

	<Page showHeader="false">
		<Panel class="sapUiSmallMarginTop" >
			<Toolbar >
				<Button icon="sap-icon://navigation-left-arrow" press="aoPressionarRetornarNavegacao"/>
				<Title text="{i18n>Cadastro.Titulo}"/>
				<ToolbarSpacer />
				<Button icon='sap-icon://save' press="aoClicarCadastrarPersonagem" text="{i18n>Cadastro.Salvar}" />
			</Toolbar>

			<VBox class="sapUiMediumMarginTop">
				<FlexBox alignItems="Start" >
					<VBox width="50%" class="sapUiMediumMarginBegin" >
						<Label text="{i18n>Cadastro.NomePersonagem}" required="true" />
						<ComboBox id="inputNome" items="{path: 'enumNome>/'}" width="100%" class="sapUiSmallMarginBottom" >
							<items>
								<c:ListItem key="{enumNome>key}" text="{enumNome>descricao}"/>
							</items>
						</ComboBox>
						<Label text="{i18n>Cadastro.Arma}" required="true" />
						<ComboBox id="inputArma" items="{path: 'enumArma>/'}" width="100%" class="sapUiSmallMarginBottom" >
							<items>
								<c:ListItem key="{enumArma>key}" text="{enumArma>descricao}"/>
							</items>
						</ComboBox>
						<Label text="{i18n>Cadastro.Elemento}" required="true" />
						<ComboBox id="inputElemento" items="{path: 'enumElemento>/'}" width="100%" class="sapUiSmallMarginBottom" >
							<items>
								<c:ListItem key="{enumElemento>key}" text="{enumElemento>descricao}"/>
							</items>
						</ComboBox>
						<Label text="{i18n>Cadastro.NomeUsuario}" required="true" />
						<Input id="inputNomeUsuario" />
					</VBox>
						
					<VBox width="50%" class="sapUiMediumMarginBegin" >
						<Label text="{i18n>Cadastro.Constelacao}" required="true" />
						<Input id="inputConstelacao" class="sapUiSmallMarginBottom" />
						<Label text="{i18n>Cadastro.Vida}" required="true" />
						<Input id="inputVida" class="sapUiSmallMarginBottom" />
						<Label text="{i18n>Cadastro.Ataque}" required="true" />
						<Input id="inputAtaque" class="sapUiSmallMarginBottom" />
						<Label text="{i18n>Cadastro.Defesa}" required="true" />
						<Input id="inputDefesa" />
					</VBox>
					
					<VBox width="50%" class="sapUiMediumMarginBegin" >
						<Label text="{i18n>Cadastro.Proficiencia}" required="true" />
						<Input id="inputProficiencia" class="sapUiSmallMarginBottom" />
						<Label text="{i18n>Cadastro.Recarga}" required="true" />
						<Input id="inputRecarga" class="sapUiSmallMarginBottom" />
						<Label text="{i18n>Cadastro.DanoCrit}" required="true" />
						<Input id="inputDanoCrit" class="sapUiSmallMarginBottom" />
						<Label text="{i18n>Cadastro.TaxaCrit}" required="true" />
						<Input id="inputTaxaCrit" />
					</VBox>

					<VBox width="50%" class="sapUiMediumMarginBegin" >
						<Label text="{i18n>Cadastro.Cura}" required="true" />
						<Input id="inputCura" class="sapUiSmallMarginBottom" />
						<Label text="{i18n>Cadastro.Escudo}" required="true" />
						<Input id="inputEscudo" class="sapUiSmallMarginBottom" />
						<Label text="{i18n>Cadastro.BonusElemental}" required="true" />
						<Input id="inputBonusElemental" class="sapUiSmallMarginBottom" />
						<Label text="{i18n>Cadastro.Data}" required="true" />
						<DatePicker
                   			id="inputData"
							placeholder=" "
                    		value="{
								'path':'/dateTime',
								'type':'sap.ui.model.type.DateTime',
								'formatOptions': {
									'pattern': 'dd/MM/yyyy'
								}
							}"/> 
					</VBox>
				</FlexBox>
			</VBox>
		</Panel>
	</Page>
</mvc:View>